{
  "name": "forensics-web-lab-root",
  "version": "0.1.0",
  "private": true,
  "description": "Forensics Web Lab - Research and web tool for AI image detection and localization",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,html,css}\""
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
