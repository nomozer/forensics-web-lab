{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forensics-web-lab.local/schemas/dataset-registry.v1.schema.json",
  "title": "DatasetRegistry",
  "description": "Schema for machine-checkable dataset registration, intellectual property audit, and track isolation in Forensics Web Lab",
  "type": "object",
  "required": ["schemaVersion", "datasets"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "track",
          "officialSource",
          "downloadSource",
          "codeLicense",
          "datasetLicense",
          "additionalTerms",
          "commercialUse",
          "redistribution",
          "derivativeWeights",
          "availability",
          "expectedDownloadBytes",
          "checksumAvailable",
          "licenseEvidenceUrls",
          "reviewedAt",
          "status",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "track": {
            "type": "string",
            "enum": ["research-only", "product-eligible", "blocked"]
          },
          "officialSource": {
            "type": "string"
          },
          "downloadSource": {
            "type": "string"
          },
          "codeLicense": {
            "type": "string"
          },
          "datasetLicense": {
            "type": "string"
          },
          "additionalTerms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "commercialUse": {
            "type": "string",
            "enum": ["allowed", "prohibited", "unclear"]
          },
          "redistribution": {
            "type": "string",
            "enum": ["allowed", "prohibited", "unclear"]
          },
          "derivativeWeights": {
            "type": "string",
            "enum": ["allowed", "prohibited", "unclear"]
          },
          "availability": {
            "type": "string",
            "enum": ["available", "pending", "unavailable"]
          },
          "expectedDownloadBytes": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "checksumAvailable": {
            "type": "boolean"
          },
          "licenseEvidenceUrls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "verified", "blocked", "rejected"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
